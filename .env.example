# Default = mock (no credentials needed)
PAYGUARD_MODE=mock
# PAYGUARD_MODE=sandbox  # requires vault-run paypal-sandbox

# Sandbox (provided by: vault-run paypal-sandbox -- … as HERMES_VAULT_SECRET=CLIENT_ID:SECRET)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Only https://api-m.sandbox.paypal.com is accepted; Live is refused.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Origin PayPal redirects the payer back to (return_url / cancel_url)
PAYGUARD_APP_BASE_URL=http://127.0.0.1:3047

# LLM via OmniRoute (OpenAI-compatible). No key = rules only (labeled).
# scripts/with-omniroute.sh exports the key from the Hermes env file without printing it.
# PAYGUARD_LLM_BASE_URL=http://127.0.0.1:20128/v1
# PAYGUARD_LLM_API_KEY=
# PAYGUARD_LLM_MODEL=free-smart
# PAYGUARD_LLM_TIMEOUT_MS=30000
# PAYGUARD_LLM_DISABLED=1

# Policy defaults (USD cents)
PAYGUARD_PER_TX_CENTS=5000
PAYGUARD_DAILY_CENTS=20000
PAYGUARD_CURRENCY=USD
PAYGUARD_ALLOW_PAYEES=creator@goalworld.fun,tools@goalworld.fun,vendor-sandbox@example.com

PORT=3047
