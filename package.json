{
  "name": "goalworld-payguard",
  "version": "0.2.0",
  "private": true,
  "description": "GoalWorld PayGuard — AI agents propose/guard/execute PayPal sandbox payments under human spend policy",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3047",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3047",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "demo:llm": "scripts/with-omniroute.sh tsx scripts/demo.ts",
    "demo:offline": "PAYGUARD_LLM_DISABLED=1 tsx scripts/demo.ts",
    "start:llm": "scripts/with-omniroute.sh next start -H 127.0.0.1 -p 3047",
    "smoke:sandbox": "tsx scripts/sandbox-smoke.ts",
    "screenshot": "scripts/screenshot.sh"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
